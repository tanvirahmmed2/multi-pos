-- =====================================================
-- BRANCHES
-- =====================================================
CREATE TABLE branches (
  branch_id SERIAL PRIMARY KEY,
  name VARCHAR(150) NOT NULL,
  code VARCHAR(50) UNIQUE,
  address TEXT,
  phone VARCHAR(20),
  email VARCHAR(150),
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- staffS
-- =====================================================
CREATE TABLE staffs (
  staff_id SERIAL PRIMARY KEY,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  name VARCHAR(100) NOT NULL,
  email VARCHAR(150) UNIQUE NOT NULL,
  phone VARCHAR(20),
  password TEXT NOT NULL,
  is_varified BOOLEAN DEFAULT FALSE,
  varification_token TEXT NULL,
  recover_token TEXT NULL,
  recover_token_expires TIMESTAMP DEFAULT NULL,
  role TEXT DEFAULT 'staff'
    CHECK (role IN ('admin','manager','sales','staff')),
  is_active BOOLEAN DEFAULT TRUE,
  is_banned BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- CUSTOMERS
-- =====================================================
CREATE TABLE customers (
  customer_id SERIAL PRIMARY KEY,
  name VARCHAR(100),
  phone VARCHAR(20) NOT NULL,
  email VARCHAR(100),
  address TEXT,
  created_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- CATEGORIES & BRANDS
-- =====================================================
CREATE TABLE categories (
  category_id SERIAL PRIMARY KEY,
  parent_id INT REFERENCES categories(category_id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  slug VARCHAR(100) NOT NULL,
  image TEXT,
  image_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE brands (
  brand_id SERIAL PRIMARY KEY,
  image TEXT,
  image_id TEXT,
  name VARCHAR(100) NOT NULL,
  description TEXT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- PRODUCTS & VARIANTS
-- =====================================================
CREATE TABLE products (
  product_id SERIAL PRIMARY KEY,
  category_id INT REFERENCES categories(category_id),
  brand_id INT REFERENCES brands(brand_id),
  name VARCHAR(150) NOT NULL,
  slug VARCHAR(150) UNIQUE,
  description TEXT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TABLE product_variants (
  variant_id SERIAL PRIMARY KEY,
  product_id INT NOT NULL
      REFERENCES products(product_id)
      ON DELETE CASCADE,
  variant_name VARCHAR(150) DEFAULT 'Default',
  barcode VARCHAR(100) UNIQUE,
  purchase_price NUMERIC(10,2) NOT NULL,
  sale_price NUMERIC(10,2) NOT NULL,
  discount_price NUMERIC(10,2) DEFAULT 0,
  wholesale_price NUMERIC(10,2),
  dealer_price NUMERIC(10,2),
  retail_price NUMERIC(10,2),
  stock INT DEFAULT 0,
  image TEXT,
  image_id VARCHAR(255),
  weight NUMERIC(10,2),
  unit VARCHAR(30),
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- STOCKS (Per Variant & Branch)
-- =====================================================
CREATE TABLE stocks (
  stock_id SERIAL PRIMARY KEY,
  variant_id INT NOT NULL REFERENCES product_variants(variant_id) ON DELETE CASCADE,
  branch_id INT NOT NULL REFERENCES branches(branch_id) ON DELETE CASCADE,
  stock INT NOT NULL DEFAULT 0,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now(),
  UNIQUE(variant_id, branch_id)
);

-- =====================================================
-- SUPPLIERS & PURCHASES
-- =====================================================
CREATE TABLE suppliers (
  supplier_id SERIAL PRIMARY KEY,
  name VARCHAR(200) NOT NULL,
  company_name VARCHAR(200),
  phone VARCHAR(20) NOT NULL,
  email VARCHAR(150),
  address TEXT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TABLE purchases (
  purchase_id SERIAL PRIMARY KEY,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  supplier_id INT REFERENCES suppliers(supplier_id),
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  supplier_name VARCHAR(200),
  supplier_phone VARCHAR(20),
  invoice_no VARCHAR(100),
  subtotal_amount NUMERIC(10,2) DEFAULT 0,
  extra_discount NUMERIC(10,2) DEFAULT 0,
  total_amount NUMERIC(10,2) DEFAULT 0,
  payment_method VARCHAR(50),
  transaction_id VARCHAR(100),
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE purchase_items (
  id SERIAL PRIMARY KEY,
  purchase_id INT REFERENCES purchases(purchase_id) ON DELETE CASCADE,
  product_id INT REFERENCES products(product_id),
  variant_id INT REFERENCES product_variants(variant_id) ON DELETE SET NULL,
  quantity INT NOT NULL,
  purchase_price NUMERIC(10,2) NOT NULL
);

CREATE TABLE purchase_payments (
  payment_id SERIAL PRIMARY KEY,
  purchase_id INT REFERENCES purchases(purchase_id),
  payment_method VARCHAR(50),
  amount_paid NUMERIC(10,2),
  transaction_id VARCHAR(100),
  payment_date TIMESTAMP DEFAULT now()
);

-- =====================================================
-- ORDERS & ORDER ITEMS
-- =====================================================
CREATE TABLE orders (
  order_id            SERIAL PRIMARY KEY,
  branch_id           INTEGER REFERENCES branches(branch_id) ON DELETE SET NULL,
  customer_id         INTEGER REFERENCES customers(customer_id),
  staff_id            INTEGER REFERENCES staffs(staff_id) ON DELETE SET NULL,
  phone               VARCHAR(20) NOT NULL,
  shipping_address    TEXT NOT NULL,
  shipping_city       VARCHAR(100),
  shipping_area       VARCHAR(100),
  courier_name        VARCHAR(100),
  courier_tracking_id VARCHAR(100),
  status              VARCHAR(30) DEFAULT 'pending'
                      CHECK (status IN (
                          'pending', 'confirmed', 'processing', 'shipped', 
                          'out_for_delivery', 'delivered', 'cancelled', 
                          'returned', 'failed'
                      )),
  subtotal_amount       NUMERIC(10, 2) NOT NULL,
  total_discount_amount NUMERIC(10, 2) DEFAULT 0,
  delivery_charge       NUMERIC(10, 2) DEFAULT 0,
  total_amount          NUMERIC(10, 2) NOT NULL,
  due_amount            NUMERIC(10, 2) DEFAULT 0,
  payment_type        VARCHAR(20) DEFAULT 'cod'
                  CHECK (payment_type IN ('cod', 'prepaid')),
  note                TEXT,
  created_at          TIMESTAMP WITHOUT TIME ZONE DEFAULT NOW(),
  updated_at          TIMESTAMP WITHOUT TIME ZONE DEFAULT NOW()
);

CREATE TABLE order_items (
  order_item_id SERIAL PRIMARY KEY,
  order_id   INT REFERENCES orders(order_id) ON DELETE CASCADE,
  product_id INT REFERENCES products(product_id),
  variant_id INT REFERENCES product_variants(variant_id) ON DELETE SET NULL,
  quantity INT NOT NULL,
  price NUMERIC(10,2) NOT NULL
);

-- =====================================================
-- PAYMENTS
-- =====================================================
CREATE TABLE payments (
  payment_id       SERIAL PRIMARY KEY,
  order_id         INTEGER NOT NULL REFERENCES orders(order_id) ON DELETE CASCADE,
  payment_method   VARCHAR(50),
  transaction_id   VARCHAR(100), 
  amount           NUMERIC(10, 2) NOT NULL,
  amount_received  NUMERIC(10, 2) DEFAULT 0,
  change_amount    NUMERIC(10, 2) DEFAULT 0,
  payment_status   VARCHAR(30) DEFAULT 'pending'
                   CHECK (payment_status IN (
                      'pending',  
                      'failed', 
                      'refunded', 
                      'partial', 
                      'completed'
                   )),
  paid_at          TIMESTAMP WITHOUT TIME ZONE DEFAULT NOW(),
  note             TEXT
);

-- =====================================================
-- DAMAGES & DAMAGE ITEMS
-- =====================================================
CREATE TABLE damages (
  damage_id SERIAL PRIMARY KEY,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  damage_date TIMESTAMP DEFAULT now(),
  total_loss_amount NUMERIC(10,2) DEFAULT 0,
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TABLE damage_items (
  damage_item_id SERIAL PRIMARY KEY,
  damage_id INT REFERENCES damages(damage_id) ON DELETE CASCADE,
  product_id INT REFERENCES products(product_id),
  variant_id INT REFERENCES product_variants(variant_id) ON DELETE SET NULL,
  quantity INT NOT NULL,
  unit_cost NUMERIC(10,2) DEFAULT 0,
  total_cost NUMERIC(10,2) DEFAULT 0,
  reason TEXT
);

-- =====================================================
-- INVESTORS
-- =====================================================
CREATE TABLE investors (
  investor_id SERIAL PRIMARY KEY,
  name VARCHAR(150) NOT NULL,
  phone VARCHAR(20),
  email VARCHAR(150),
  address TEXT,
  nid_passport VARCHAR(100),
  is_active BOOLEAN DEFAULT TRUE,
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- MONEY WITHDRAWALS
-- =====================================================
CREATE TABLE withdrawals (
  withdrawal_id SERIAL PRIMARY KEY,
  investor_id INT REFERENCES investors(investor_id) ON DELETE SET NULL,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  investor_name VARCHAR(150),
  amount NUMERIC(10,2) NOT NULL,
  withdrawal_type VARCHAR(30) DEFAULT 'investment' CHECK (withdrawal_type IN ('investment', 'profit')),
  payment_method VARCHAR(50) DEFAULT 'cash',
  account_details TEXT,
  status VARCHAR(30) DEFAULT 'completed'
    CHECK (status IN ('pending', 'approved', 'completed', 'rejected', 'cancelled')),
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- INVESTMENTS
-- =====================================================
CREATE TABLE investments (
  investment_id SERIAL PRIMARY KEY,
  investor_id INT REFERENCES investors(investor_id) ON DELETE SET NULL,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  investor_name VARCHAR(150) NOT NULL,
  investor_phone VARCHAR(20),
  investor_email VARCHAR(150),
  amount NUMERIC(10,2) NOT NULL,
  payment_method VARCHAR(50) DEFAULT 'bank_transfer',
  reference_no VARCHAR(100),
  investment_date TIMESTAMP DEFAULT now(),
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_payments_order_id ON payments(order_id);
CREATE INDEX idx_payments_payment_method ON payments(payment_method);
CREATE INDEX idx_stocks_variant_branch ON stocks(variant_id, branch_id);
CREATE INDEX idx_orders_branch_id ON orders(branch_id);
CREATE INDEX idx_orders_staff_id ON orders(staff_id);
CREATE INDEX idx_purchases_branch_id ON purchases(branch_id);
CREATE INDEX idx_purchases_staff_id ON purchases(staff_id);
CREATE INDEX idx_staffs_branch_id ON staffs(branch_id);
CREATE INDEX idx_damages_branch_id ON damages(branch_id);
CREATE INDEX idx_damages_staff_id ON damages(staff_id);
CREATE INDEX idx_damage_items_damage_id ON damage_items(damage_id);
CREATE INDEX idx_withdrawals_branch_id ON withdrawals(branch_id);
CREATE INDEX idx_withdrawals_staff_id ON withdrawals(staff_id);
CREATE INDEX idx_withdrawals_investor_id ON withdrawals(investor_id);
CREATE INDEX idx_investments_branch_id ON investments(branch_id);
CREATE INDEX idx_investments_staff_id ON investments(staff_id);
CREATE INDEX idx_investments_investor_id ON investments(investor_id);

-- =====================================================
-- INVENTORY LOGS & REFUNDS
-- =====================================================
CREATE TABLE inventory_logs (
  log_id SERIAL PRIMARY KEY,
  product_id INT REFERENCES products(product_id),
  variant_id INT REFERENCES product_variants(variant_id) ON DELETE SET NULL,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  type TEXT CHECK (type IN ('purchase','sale','adjustment','return','transfer','damage')),
  quantity INT NOT NULL,
  reference_id INT,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE refunds (
  refund_id SERIAL PRIMARY KEY,
  order_id INT REFERENCES orders(order_id),
  amount NUMERIC(10,2),
  reason TEXT,
  status TEXT DEFAULT 'pending'
    CHECK (status IN ('pending','approved','rejected')),
  created_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- ISSUES & WEBSITES
-- =====================================================
CREATE TABLE issues (
  issue_id SERIAL PRIMARY KEY,
  sender_id INT REFERENCES staffs(staff_id) ON DELETE CASCADE,
  receiver_id INT REFERENCES staffs(staff_id) ON DELETE CASCADE,
  title VARCHAR(200) NOT NULL,
  message TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE OR REPLACE VIEW issues_view AS
SELECT 
  i.issue_id,
  i.sender_id,
  s.name AS sender_name,
  s.email AS sender_email,
  s.role AS sender_role,
  i.receiver_id,
  r.name AS receiver_name,
  r.email AS receiver_email,
  r.role AS receiver_role,
  i.title,
  i.message,
  i.created_at
FROM issues i
LEFT JOIN staffs s ON i.sender_id = s.staff_id
LEFT JOIN staffs r ON i.receiver_id = r.staff_id;

-- =====================================================
-- CURRENCIES
-- =====================================================
CREATE TABLE currencies (
  currency_id SERIAL PRIMARY KEY,
  code VARCHAR(10) UNIQUE NOT NULL,
  name VARCHAR(100) NOT NULL,
  symbol VARCHAR(10) NOT NULL,
  is_active BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE websites (
  website_id SERIAL PRIMARY KEY,
  logo TEXT,
  logo_id TEXT,
  hero_title TEXT,
  hero_subtitle TEXT,
  address TEXT,
  sociallink TEXT,
  email TEXT,
  phone TEXT,
  is_share_investment BOOLEAN DEFAULT FALSE,
  excluded_tax BOOLEAN DEFAULT FALSE,
  tax_amount NUMERIC(10,2) DEFAULT 0,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- LOGIN & ACTIVITY LOGS
-- =====================================================
CREATE TABLE login_logs (
  log_id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  email VARCHAR(150),
  role VARCHAR(50),
  ip_address VARCHAR(100),
  user_agent TEXT,
  status VARCHAR(50) DEFAULT 'success' CHECK (status IN ('success', 'failed')),
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE activity_logs (
  activity_id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  action VARCHAR(100) NOT NULL,
  entity VARCHAR(100),
  entity_id INT,
  details TEXT,
  ip_address VARCHAR(100),
  user_agent TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_login_logs_staff_id ON login_logs(staff_id);
CREATE INDEX idx_activity_logs_staff_id ON activity_logs(staff_id);

-- =====================================================
-- SALARIES & PAYROLL MANAGEMENT
-- =====================================================
CREATE TABLE salaries (
  salary_id SERIAL PRIMARY KEY,
  title VARCHAR(100) NOT NULL,
  base_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
  bonus NUMERIC(12, 2) DEFAULT 0.00,
  allowance NUMERIC(12, 2) DEFAULT 0.00,
  deduction NUMERIC(12, 2) DEFAULT 0.00,
  net_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE staff_salaries (
  staff_salary_id SERIAL PRIMARY KEY,
  salary_id INT REFERENCES salaries(salary_id) ON DELETE CASCADE,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE CASCADE,
  effective_date DATE DEFAULT CURRENT_DATE,
  status VARCHAR(20) DEFAULT 'active',
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE TABLE salary_payments (
  payment_id SERIAL PRIMARY KEY,
  staff_salary_id INT REFERENCES staff_salaries(staff_salary_id) ON DELETE CASCADE,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE CASCADE,
  amount NUMERIC(12, 2) NOT NULL,
  payment_month VARCHAR(20),
  payment_method VARCHAR(50) DEFAULT 'bank_transfer',
  account_details TEXT,
  transaction_id VARCHAR(100),
  status VARCHAR(20) DEFAULT 'completed',
  payment_date TIMESTAMP DEFAULT now(),
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_staff_salaries_staff_id ON staff_salaries(staff_id);
CREATE INDEX idx_staff_salaries_salary_id ON staff_salaries(salary_id);
CREATE INDEX idx_salary_payments_staff_salary_id ON salary_payments(staff_salary_id);
CREATE INDEX idx_salary_payments_staff_id ON salary_payments(staff_id);

-- =====================================================
-- SHARES & EQUITY ALLOCATION
-- =====================================================
CREATE TABLE shares (
  share_id SERIAL PRIMARY KEY,
  investor_id INT REFERENCES investors(investor_id) ON DELETE CASCADE,
  share_percentage NUMERIC(5,2) NOT NULL DEFAULT 0.00,
  status VARCHAR(20) DEFAULT 'active' CHECK (status IN ('active', 'inactive')),
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_shares_investor_id ON shares(investor_id);

-- =====================================================
-- FINANCIAL AVAILABLE BALANCE
-- =====================================================
CREATE TABLE available_balance (
  balance_id SERIAL PRIMARY KEY,
  available_balance NUMERIC(14,2) NOT NULL DEFAULT 0.00,
  updated_at TIMESTAMP DEFAULT now()
);

-- =====================================================
-- INVESTOR PROFITS ALLOCATION
-- =====================================================
CREATE TABLE profits (
  profit_id SERIAL PRIMARY KEY,
  investor_id INT REFERENCES investors(investor_id) ON DELETE CASCADE,
  profit_date DATE DEFAULT CURRENT_DATE,
  amount NUMERIC(14,2) NOT NULL DEFAULT 0.00,
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_profits_investor_id ON profits(investor_id);

-- =====================================================
-- EXPENSES MANAGEMENT
-- =====================================================
CREATE TABLE expenses (
  expense_id SERIAL PRIMARY KEY,
  branch_id INT REFERENCES branches(branch_id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  title VARCHAR(200) NOT NULL,
  category VARCHAR(100) DEFAULT 'General',
  expense_date DATE DEFAULT CURRENT_DATE,
  total_amount NUMERIC(12,2) NOT NULL DEFAULT 0.00,
  paid_amount NUMERIC(12,2) DEFAULT 0.00,
  due_amount NUMERIC(12,2) DEFAULT 0.00,
  payment_method VARCHAR(50) DEFAULT 'cash',
  status VARCHAR(20) DEFAULT 'completed' CHECK (status IN ('pending', 'completed', 'partial', 'cancelled')),
  note TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TABLE expense_items (
  expense_item_id SERIAL PRIMARY KEY,
  expense_id INT REFERENCES expenses(expense_id) ON DELETE CASCADE,
  item_name VARCHAR(200) NOT NULL,
  quantity INT DEFAULT 1,
  unit_cost NUMERIC(12,2) NOT NULL DEFAULT 0.00,
  total_cost NUMERIC(12,2) NOT NULL DEFAULT 0.00
);

CREATE TABLE expense_payments (
  payment_id SERIAL PRIMARY KEY,
  expense_id INT REFERENCES expenses(expense_id) ON DELETE CASCADE,
  amount NUMERIC(12,2) NOT NULL DEFAULT 0.00,
  payment_method VARCHAR(50) DEFAULT 'cash',
  transaction_id VARCHAR(100),
  payment_date TIMESTAMP DEFAULT now(),
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_expenses_branch_id ON expenses(branch_id);
CREATE INDEX idx_expenses_staff_id ON expenses(staff_id);
CREATE INDEX idx_expense_items_expense_id ON expense_items(expense_id);
CREATE INDEX idx_expense_payments_expense_id ON expense_payments(expense_id);

-- =====================================================
-- MANUAL BALANCE TRANSACTIONS
-- =====================================================
CREATE TABLE balance_transactions (
  transaction_id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(staff_id) ON DELETE SET NULL,
  type VARCHAR(50) DEFAULT 'deposit',
  amount NUMERIC(14,2) NOT NULL DEFAULT 0.00,
  payment_method VARCHAR(50) DEFAULT 'cash',
  reference_no VARCHAR(100),
  note TEXT,
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX idx_balance_transactions_staff_id ON balance_transactions(staff_id);




